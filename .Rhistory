make_kin_pw_matrix <- function(results, input_df){
# determine kinase order in the resulting df
gene_order <- input_df %>%
arrange("Kinase Family") %>%
pull("Kinase Name")
df_fc <- results %>%
mutate(core_genes = str_split(core_genes, ", ")) %>%
unnest(core_genes) %>%
rename("Kinase Name" = core_genes)  %>% # Rename for joining
left_join(input_df[,c("Kinase Name", "Median Kinase Statistic", "family")], by = "Kinase Name") %>%
pivot_wider(names_from = "Kinase Name", values_from = 'Median Kinase Statistic', values_fill = 0) %>%
select("pathwayid", "pathwayname", "set.size", "enrichmentScore", "NES", "p.val", "FDR", "direction", all_of(gene_order))
}
fc_mat <- make_kin_pw_matrix(results, input_df)
