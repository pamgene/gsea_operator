source("R/gsea.R")
library(clusterProfiler)
library(gage)
data(egSymb)
fscore_thr <- 1.3
fdr_cutoff <- 0.3
idmap_kin <- read_csv("data/idmap_id_entrez_uniname_kinase.csv")
input_df <- read_csv("UKA_test.csv") %>% clean_tercen_columns() %>% filter(contrast == "T1-15P vs C-N")
parse_uka <- function(input_df, fscore_thr, idmap_kin){
# filter by final score threshold
input_df %>%
left_join(idmap_kin, by = c("Kinase Uniprot ID" = "uniprot")) %>%
filter(`Median Final score` >= fscore_thr) %>%
dplyr::select(entrezid, `Median Kinase Statistic`) %>%
arrange(desc(`Median Kinase Statistic`)) %>%
tibble::deframe()
}
make_kin_pw_matrix <- function(gsea_result, input_df){
df_fc <- gsea_result %>%
unnest(pathway.elements) %>%
rename("Kinase Name" = pathway.elements)  %>% # Rename for joining
left_join(input_df[,c("Kinase Name", "Median Kinase Statistic")], by = "Kinase Name")
# Create a fold change matrix
df_fc %>%
pivot_wider(names_from = "Kinase Name", values_from = 'Median Kinase Statistic', values_fill = 0)
}
uka_fcv <- parse_uka(input_df = input_df, fscore_thr = fscore_thr, idmap_kin = idmap_kin)
# Do GSEA
gseaKEGG <- gseKEGG(geneList = uka_fcv,
organism = "hsa",
pvalueCutoff = fdr_cutoff,
pAdjustMethod = "fdr",
verbose = F)
# Make results table
results <- parse_gsea_clusterprofiler_res(gseaKEGG@result)
a <- gseaKEGG@resul
a <- gseaKEGG@result
View(a)
gseKEGG(geneList = uka_fcv,
organism = "hsa",
pvalueCutoff = 1,
pAdjustMethod = "fdr",
verbose = F)
